#!/usr/bin/env bash
set -e

CONF_DIR="$HOME/.config/proxyrun"
PROFILES_FILE="$CONF_DIR/profiles.tsv"
DEFAULT_FILE="$CONF_DIR/default"
APPS_FILE="$CONF_DIR/apps.txt"

mkdir -p "$CONF_DIR"

if [ ! -f "$PROFILES_FILE" ]; then
    cat << 'INIT_EOF' > "$PROFILES_FILE"
home-http	http://192.168.1.55:18080	Home HTTP Proxy
home-socks	socks5h://192.168.1.55:10808	Home SOCKS5 Router
direct	DIRECT	Direct connection (No proxy)
INIT_EOF
fi

[ ! -f "$DEFAULT_FILE" ] && echo "home-http" > "$DEFAULT_FILE"

if [ ! -f "$APPS_FILE" ]; then
    cat << 'INIT_EOF' > "$APPS_FILE"
opencode
codex
aider
bash
INIT_EOF
fi

get_default_id() {
    cat "$DEFAULT_FILE" 2>/dev/null || echo "direct"
}

get_profile_url() {
    local id="$1"
    awk -F'\t' -v target="$id" '$1 == target {print $2}' "$PROFILES_FILE"
}

get_profile_desc() {
    local id="$1"
    awk -F'\t' -v target="$id" '$1 == target {print $3}' "$PROFILES_FILE"
}

fetch_geo_info() {
    local url="$1"
    local raw_json=""
    local curl_cmd=(curl -s -m 4)

    if [ "$url" != "DIRECT" ] && [ -n "$url" ]; then
        curl_cmd+=(-x "$url")
    fi
    curl_cmd+=(https://ipinfo.io)

    raw_json=$("${curl_cmd[@]}" 2>/dev/null || true)

    if [ -z "$raw_json" ]; then
        echo "FAIL||"
        return 0
    fi

    python3 -c '
import sys, json
try:
    d = json.loads(sys.argv[1])
    ip = d.get("ip", "N/A")
    city = d.get("city", "")
    country = d.get("country", "")
    loc = f"{city}, {country}".strip(", ")
    org = d.get("org", "N/A")
    print(f"{ip}|{loc}|{org}")
except Exception:
    print("FAIL||")
' "$raw_json"
}

add_profile() {
    echo ""
    local id desc proto addr url
    id=$(gum input --placeholder "например: ca-proton, work-vps" --prompt "ID профиля (без пробелов): ")
    id=$(echo "$id" | tr -d '[:space:]')
    [ -z "$id" ] && return 0

    if grep -q "^$id"$'\t' "$PROFILES_FILE" 2>/dev/null; then
        gum style --foreground 1 "Профиль с таким ID уже существует!"
        sleep 1.5
        return 0
    fi

    desc=$(gum input --placeholder "например: Canadian Proton SOCKS5" --prompt "Описание: ")
    [ -z "$desc" ] && desc="$id"

    proto=$(gum choose --header "Выберите тип протокола:" "SOCKS5" "HTTP")
    [ -z "$proto" ] && return 0

    local placeholder="127.0.0.1:10809"
    [ "$proto" = "HTTP" ] && placeholder="192.168.1.55:18080"

    addr=$(gum input --placeholder "$placeholder" --prompt "Адрес и порт (host:port): ")
    addr=$(echo "$addr" | xargs)
    [ -z "$addr" ] && return 0

    addr=$(echo "$addr" | sed -E 's|^[a-zA-Z0-9+.-]+://||')

    if [ "$proto" = "SOCKS5" ]; then
        url="socks5h://$addr"
    else
        url="http://$addr"
    fi

    echo -e "${id}\t${url}\t${desc}" >> "$PROFILES_FILE"
    gum style --foreground 2 "✓ Профиль [$id] успешно сохранён ($url)!"

    if gum confirm "Сделать его профилем по умолчанию?"; then
        echo "$id" > "$DEFAULT_FILE"
        CACHED_FOR_ID=""
    fi
}

edit_profile() {
    mapfile -t ids < <(awk -F'\t' '$1 != "direct" {print $1}' "$PROFILES_FILE")
    if [ ${#ids[@]} -eq 0 ]; then
        gum style --foreground 3 "Нет пользовательских профилей для редактирования."
        sleep 1.5
        return 0
    fi

    echo ""
    local target
    target=$(gum choose --header "Выберите профиль для редактирования:" "${ids[@]}" "« Отмена")
    [ "$target" = "« Отмена" ] || [ -z "$target" ] && return 0

    local cur_url cur_desc cur_proto cur_addr
    cur_url=$(get_profile_url "$target")
    cur_desc=$(get_profile_desc "$target")

    cur_addr=$(echo "$cur_url" | sed -E 's|^[a-zA-Z0-9+.-]+://||')
    local proto_opts=()
    if [[ "$cur_url" =~ ^socks ]]; then
        proto_opts=("SOCKS5" "HTTP")
    else
        proto_opts=("HTTP" "SOCKS5")
    fi

    echo ""
    gum style --bold "Редактирование профиля [$target]:"

    local new_id new_desc new_proto new_addr new_url
    new_id=$(gum input --value "$target" --prompt "ID профиля: ")
    new_id=$(echo "$new_id" | tr -d '[:space:]')
    [ -z "$new_id" ] && new_id="$target"

    if [ "$new_id" != "$target" ] && grep -q "^$new_id"$'\t' "$PROFILES_FILE" 2>/dev/null; then
        gum style --foreground 1 "Профиль с ID [$new_id] уже существует!"
        sleep 1.5
        return 0
    fi

    new_desc=$(gum input --value "$cur_desc" --prompt "Описание: ")
    [ -z "$new_desc" ] && new_desc="$cur_desc"

    new_proto=$(gum choose --header "Тип протокола (текущий: ${proto_opts[0]}):" "${proto_opts[@]}")
    [ -z "$new_proto" ] && new_proto="${proto_opts[0]}"

    new_addr=$(gum input --value "$cur_addr" --prompt "Адрес и порт (host:port): ")
    new_addr=$(echo "$new_addr" | sed -E 's|^[a-zA-Z0-9+.-]+://||' | xargs)
    [ -z "$new_addr" ] && new_addr="$cur_addr"

    if [ "$new_proto" = "SOCKS5" ]; then
        new_url="socks5h://$new_addr"
    else
        new_url="http://$new_addr"
    fi

    grep -v "^$target"$'\t' "$PROFILES_FILE" > "$PROFILES_FILE.tmp" || true
    echo -e "${new_id}\t${new_url}\t${new_desc}" >> "$PROFILES_FILE.tmp"
    mv "$PROFILES_FILE.tmp" "$PROFILES_FILE"

    local def_id
    def_id=$(get_default_id)
    if [ "$def_id" = "$target" ]; then
        echo "$new_id" > "$DEFAULT_FILE"
    fi

    CACHED_FOR_ID=""
    gum style --foreground 2 "✓ Профиль успешно обновлён ($new_url)!"
    sleep 1
}

delete_profile() {
    local default_id
    default_id=$(get_default_id)

    mapfile -t ids < <(awk -F'\t' '$1 != "direct" {print $1}' "$PROFILES_FILE")
    if [ ${#ids[@]} -eq 0 ]; then
        gum style --foreground 3 "Нет пользовательских профилей для удаления."
        sleep 1.5
        return 0
    fi

    echo ""
    local target
    target=$(gum choose --header "Выберите профиль для удаления:" "${ids[@]}" "« Отмена")
    [ "$target" = "« Отмена" ] || [ -z "$target" ] && return 0

    if gum confirm "Удалить профиль [$target]?"; then
        grep -v "^$target"$'\t' "$PROFILES_FILE" > "$PROFILES_FILE.tmp" && mv "$PROFILES_FILE.tmp" "$PROFILES_FILE"
        if [ "$default_id" = "$target" ]; then
            echo "direct" > "$DEFAULT_FILE"
            gum style --foreground 3 "Активный профиль сброшен на direct."
        fi
        CACHED_FOR_ID=""
        gum style --foreground 2 "Профиль удалён."
        sleep 1
    fi
}

# Режим быстрого выбора перед запуском приложения
select_and_run() {
    local cmd=("$@")
    if [ ${#cmd[@]} -eq 0 ]; then
        echo "Ошибка: не указана команда для запуска." >&2
        exit 1
    fi

    local def_id
    def_id=$(get_default_id)

    # Дефолтный профиль ставим САМЫМ ПЕРВЫМ, чтобы Enter сразу запускал его
    local menu_items=()
    local def_url def_desc
    def_url=$(get_profile_url "$def_id")
    def_desc=$(get_profile_desc "$def_id")

    menu_items+=("● $def_id — $def_desc ($def_url) [Enter: Старт]")

    while IFS=$'\t' read -r id url desc; do
        [ -z "$id" ] && continue
        [ "$id" = "$def_id" ] && continue
        menu_items+=("○ $id — $desc ($url)")
    done < "$PROFILES_FILE"

    menu_items+=(
        "────────────────────────────────────────"
        "⚙️  Настройки ProxyRun (добавить/изменить)"
        "✕ Отмена"
    )

    local choice
    choice=$(gum choose --header "Запуск [${cmd[*]}] через прокси:" "${menu_items[@]}")

    case "$choice" in
        "✕ Отмена"|"")
            clear
            exit 0
            ;;
        "────────────────────────────────────────")
            clear
            exit 0
            ;;
        "⚙️  Настройки ProxyRun (добавить/изменить)")
            tui_menu
            exit 0
            ;;
        *)
            local selected_id
            selected_id=$(echo "$choice" | sed -E 's/^[●○] ([^ —]+).*/\1/')
            clear
            exec proxyrun -p "$selected_id" "${cmd[@]}"
            ;;
    esac
}

CACHED_FOR_ID=""
CACHED_IP=""
CACHED_LOC=""
CACHED_ORG=""
CACHED_OK=0

check_current_proxy_status() {
    local def_id="$1"
    local def_url="$2"

    if [ "$CACHED_FOR_ID" != "$def_id" ]; then
        local geo_data
        geo_data=$(gum spin --spinner dot --title "Проверка соединения [$def_id]..." -- bash -c "$(declare -f fetch_geo_info); fetch_geo_info '$def_url'")
        
        IFS='|' read -r CACHED_IP CACHED_LOC CACHED_ORG <<< "$geo_data"
        if [ "$CACHED_IP" = "FAIL" ] || [ -z "$CACHED_IP" ]; then
            CACHED_OK=0
        else
            CACHED_OK=1
        fi
        CACHED_FOR_ID="$def_id"
    fi
}

tui_menu() {
    if ! command -v gum >/dev/null 2>&1; then
        echo "Ошибка: утилита gum не найдена. Установите: sudo pacman -S gum"
        exit 1
    fi

    while true; do
        clear
        local def_id def_url def_desc
        def_id=$(get_default_id)
        def_url=$(get_profile_url "$def_id")
        def_desc=$(get_profile_desc "$def_id")

        check_current_proxy_status "$def_id" "$def_url"

        gum style \
            --border double \
            --margin "0 1" \
            --padding "0 2" \
            --border-foreground 212 \
            --bold \
            "ProxyRun: Universal Agent & CLI Proxy Manager"

        echo -e " Профиль: $(gum style --bold --foreground 6 "$def_id") ($(gum style --foreground 8 "$def_url"))"

        if [ "$CACHED_OK" -eq 1 ]; then
            gum style --foreground 2 "  ● Подключение активно"
            echo -e "  ├─ IP:        $(gum style --bold "$CACHED_IP")"
            echo -e "  ├─ Локация:   $(gum style --bold "$CACHED_LOC")"
            echo -e "  └─ Провайдер: $(gum style --foreground 3 "$CACHED_ORG")"
        else
            gum style --foreground 1 "  ✗ Ошибка подключения (прокси не отвечает или нет сети)"
            echo "  └─ Проверьте адрес, порт и запущен ли демон прокси."
        fi
        echo ""

        local menu_items=()
        while IFS=$'\t' read -r id url desc; do
            [ -z "$id" ] && continue
            if [ "$id" = "$def_id" ]; then
                menu_items+=("● $id — $desc ($url)")
            else
                menu_items+=("○ $id — $desc ($url)")
            fi
        done < "$PROFILES_FILE"

        menu_items+=(
            "────────────────────────────────────────"
            "🚀 Запустить приложение..."
            "🔄 Обновить статус подключения"
            "✏️  Редактировать профиль"
            "➕ Добавить новый прокси"
            "🗑️  Удалить прокси"
            "✕ Выход"
        )

        local choice
        choice=$(gum choose --header "Выберите действие или переключите профиль:" "${menu_items[@]}")

        case "$choice" in
            "────────────────────────────────────────"|"")
                continue
                ;;
            "🚀 Запустить приложение...")
                mapfile -t apps < <(grep -v '^[[:space:]]*$' "$APPS_FILE" || true)
                apps+=("⌨️  Ввести произвольную команду..." "« Назад")
                local app_choice
                app_choice=$(gum choose --header "Что запускаем через [$def_id]?" "${apps[@]}")
                [ "$app_choice" = "« Назад" ] || [ -z "$app_choice" ] && continue

                if [ "$app_choice" = "⌨️  Ввести произвольную команду..." ]; then
                    app_choice=$(gum input --placeholder "например: curl ipinfo.io" --prompt "Команда: ")
                    [ -z "$app_choice" ] && continue
                fi
                clear
                echo "Запуск [$app_choice] через прокси [$def_id] ($def_url)..."
                exec proxyrun -p "$def_id" $app_choice
                ;;
            "🔄 Обновить статус подключения")
                CACHED_FOR_ID=""
                ;;
            "✏️  Редактировать профиль")
                edit_profile
                ;;
            "➕ Добавить новый прокси")
                add_profile
                ;;
            "🗑️  Удалить прокси")
                delete_profile
                ;;
            "✕ Выход")
                clear
                exit 0
                ;;
            *)
                local selected_id
                selected_id=$(echo "$choice" | sed -E 's/^[●○] ([^ —]+).*/\1/')
                if [ "$selected_id" != "$def_id" ]; then
                    echo "$selected_id" > "$DEFAULT_FILE"
                    CACHED_FOR_ID=""
                fi
                ;;
        esac
    done
}

# Обработка CLI параметров
SELECTED_PROFILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--menu|--config)
            tui_menu
            exit 0
            ;;
        -s|--select)
            shift
            select_and_run "$@"
            exit 0
            ;;
        -d|--direct)
            SELECTED_PROFILE="direct"
            shift
            break
            ;;
        -p|--profile)
            SELECTED_PROFILE="$2"
            shift 2
            break
            ;;
        -h|--help)
            echo "Использование:"
            echo "  proxyrun <команда> [аргументы...]      Запуск через дефолтный прокси"
            echo "  proxyrun -s <команда> [аргументы...]   Быстрый выбор прокси перед запуском команды"
            echo "  proxyrun -p <профиль> <команда>        Запуск через конкретный профиль"
            echo "  proxyrun -d <команда>                  Запуск напрямую (без прокси)"
            echo "  proxyrun (без аргументов)              Открыть главное TUI-меню с проверкой сети"
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ] && [ -z "$SELECTED_PROFILE" ]; then
    tui_menu
    exit 0
fi

if [ -z "$SELECTED_PROFILE" ]; then
    SELECTED_PROFILE=$(get_default_id)
fi

TARGET_URL=$(get_profile_url "$SELECTED_PROFILE")

if [ -z "$TARGET_URL" ]; then
    echo "Ошибка: Профиль '$SELECTED_PROFILE' не найден в $PROFILES_FILE" >&2
    exit 1
fi

if [ "$TARGET_URL" = "DIRECT" ]; then
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
else
    export HTTP_PROXY="$TARGET_URL"
    export HTTPS_PROXY="$TARGET_URL"
    export http_proxy="$TARGET_URL"
    export https_proxy="$TARGET_URL"
    export ALL_PROXY="$TARGET_URL"
    export all_proxy="$TARGET_URL"
    export NO_PROXY="localhost,127.0.0.1,::1"
    export no_proxy="localhost,127.0.0.1,::1"
fi

exec "$@"
